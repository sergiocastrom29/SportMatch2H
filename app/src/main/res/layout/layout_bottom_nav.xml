<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"
    android:paddingTop="8dp"
    android:gravity="center_vertical"
    android:background="#00000000">

    <!-- Inicio -->
    <LinearLayout
        android:id="@+id/btn_home"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bottom_nav_item_bg"
        android:layout_marginEnd="5dp">

        <ImageView
            android:id="@+id/icon_home"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            android:contentDescription="Inicio"
            app:tint="#1E8449" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Inicio"
            android:textColor="#1E8449"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Reservas -->
    <LinearLayout
        android:id="@+id/btn_reservas"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bottom_nav_item_bg"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp">

        <ImageView
            android:id="@+id/icon_reservas"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_reservas"
            android:contentDescription="Mis reservas"
            app:tint="#718096" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Reservas"
            android:textColor="#718096"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

    <!-- Perfil -->
    <LinearLayout
        android:id="@+id/btn_perfil"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bottom_nav_item_bg"
        android:layout_marginStart="5dp">

        <ImageView
            android:id="@+id/icon_perfil"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_perfil"
            android:contentDescription="Mi perfil"
            app:tint="#718096" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Perfil"
            android:textColor="#718096"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />
    </LinearLayout>

</LinearLayout>