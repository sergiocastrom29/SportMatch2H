<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A"
    android:padding="20dp"
    tools:context=".RegistroActivity">

    <!-- Imagen de fondo con overlay oscuro -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.18"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondologin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo SportMatch2H centrado arriba -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/circle_background_white"
        android:contentDescription="@string/logo_description"
        android:padding="6dp"
        android:src="@drawable/logosportmatch2hsinfondo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tarjeta de registro -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_login_container"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.04"
            android:text="@string/register_title"
            android:textColor="#1A2340"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/divider_accent" />

        <!-- Nombre completo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.06"
            android:text="@string/fullname_label"
            android:textColor="#4A5568"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/fullname"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:autofillHints="name"
            android:background="@drawable/edit_text_background"
            android:hint="@string/fullname_hint"
            android:inputType="textPersonName"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#1A2340"
            android:textColorHint="#9AA5B4"
            android:textSize="14sp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.06"
            android:text="@string/email_label"
            android:textColor="#4A5568"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/email_registro"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:autofillHints="emailAddress"
            android:background="@drawable/edit_text_background"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#1A2340"
            android:textColorHint="#9AA5B4"
            android:textSize="14sp" />

        <!-- Teléfono -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.06"
            android:text="@string/phone_label"
            android:textColor="#4A5568"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/phone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:autofillHints="phone"
            android:background="@drawable/edit_text_background"
            android:hint="@string/phone_hint"
            android:inputType="phone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#1A2340"
            android:textColorHint="#9AA5B4"
            android:textSize="14sp" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.06"
            android:text="@string/password_label"
            android:textColor="#4A5568"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/password_registro"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:autofillHints="password"
            android:background="@drawable/edit_text_background"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#1A2340"
            android:textColorHint="#9AA5B4"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress_bar_registro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Confirmar contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.06"
            android:text="@string/confirm_password_label"
            android:textColor="#4A5568"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/confirmPassword"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="2dp"
            android:autofillHints="password"
            android:background="@drawable/edit_text_background"
            android:hint="@string/confirm_password_hint"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#1A2340"
            android:textColorHint="#9AA5B4"
            android:textSize="14sp" />

        <!-- Botón registrarse -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_registrar_usuario"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.06"
            android:text="@string/register_button"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />

    </LinearLayout>

    <!-- Enlace a login -->
    <TextView
        android:id="@+id/btnGoToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/login_link"
        android:textColor="#AABBCC"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/linearLayout"
        app:layout_constraintStart_toStartOf="@+id/linearLayout"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
